#!/bin/sh
# fingerprint-ocv across suspend, installed as /usr/lib/systemd/system-sleep/fingerprint-ocv.
# On resume the kernel resets the reader and the daemon's encrypted session with it is
# gone, so stop the daemon before sleeping and start it fresh afterwards. Then wait until
# the reader is ready: logind announces the resume (PrepareForSleep false) only after this
# hook, and lock screens such as hyprlock look for the reader right then, once.
case "$1" in
    pre)
        systemctl stop fprintd.service
        ;;
    post)
        systemctl start fprintd.service
        i=0
        while [ $i -lt 50 ]; do
            busctl --system call net.reactivated.Fprint /net/reactivated/Fprint/Manager \
                net.reactivated.Fprint.Manager GetDefaultDevice >/dev/null 2>&1 && break
            sleep 0.1
            i=$((i + 1))
        done
        # a verify started right as the reader comes up never sees a finger: give the
        # sensor a moment before the lock screen asks
        sleep 0.5
        ;;
esac

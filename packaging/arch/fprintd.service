# fingerprint-ocv as the system's fprintd: installed as /etc/systemd/system/fprintd.service
# it overrides the fprintd package's unit, so net.reactivated.Fprint (fprintd-enroll,
# pam_fprintd, ...) is served by this daemon. It runs from boot: it takes the bus name
# before its objects exist, so a call that D-Bus-activates it would hit UnknownMethod.
[Unit]
Description=Fingerprint authentication daemon (fingerprint-ocv, FPC 10a5:9201)
Documentation=https://github.com/vrolife/fingerprint-ocv

[Service]
Type=dbus
BusName=net.reactivated.Fprint
ExecStart=/usr/local/bin/fingerprint-ocv --bus=system --data-path=/var/lib/fingerprint-ocv
Restart=on-failure

# needs raw USB access to the sensor (root); otherwise keep it boxed in
StateDirectory=fingerprint-ocv
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
LockPersonality=yes

[Install]
WantedBy=multi-user.target
